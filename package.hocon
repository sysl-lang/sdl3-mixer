// SDL_mixer 3 — sound and music, mixed, for sysl.
//
//     dependencies {
//       sdl3-mixer { git = "github.com/sysl-lang/sdl3-mixer", version = "0.2.0" }
//     }
//
// **SDL3 and SDL3_mixer both have to be installed** — `brew install sdl3_ttf` pulls both — and a
// build needs the prefix on the command line:
//
//     sysl run prog.sysl --include-path sdl3=/opt/homebrew/include --link-path /opt/homebrew/lib
//
// The include path is named `sdl3=` because it answers *that* package's header requirement: this
// one transcribes nothing a header could answer for, so it asks the C compiler for nothing.
//
// This is a separate package from `sdl3` rather than a module inside it, and the reason is
// mechanical: a link directive is never pruned, so a program that only drew rectangles would still
// be handed `-lSDL3_mixer` and would not link on a machine without it.

package {
  name    = "sdl3-mixer"
  version = "0.2.0"
}

// The core binding, for `Color`, `Surface`, `Renderer` and `Texture`. It is fetched by the
// coordinate below, so nothing has to be checked out beside this repository.
dependencies {
  sdl3 { git = "github.com/sysl-lang/sdl3", version = "0.2.0" }
}

requires {
  heap  = true
  posix = true
}
